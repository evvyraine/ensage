# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.

# --- Database (required) ---------------------------------------------------
# PostgreSQL 18 connection string used by the app, migrations, and cleanup.
DATABASE_URL=postgresql://ensage:ensage@localhost:5432/ensage
# Set to "true" to require TLS with a trusted certificate. Leave unset for local.
# DATABASE_SSL=false
# Max connections in the per-process pool. Total = workers × this value.
# DATABASE_POOL_MAX=10

# --- Clerk (required) ------------------------------------------------------
# Create an application at https://dashboard.clerk.com and copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Web server (optional) -------------------------------------------------
# Port for `next start` / the standalone server. Defaults to 3000.
# PORT=3000
# Number of PM2 cluster workers. Defaults to 1.
# WEB_CONCURRENCY=1

# --- Public site URL (optional, recommended in production) -----------------
# Public origin used for canonical links, Open Graph images, robots.txt and the
# web app manifest. Defaults to https://ensage.shftln.com when unset.
# NEXT_PUBLIC_APP_URL=https://ensage.shftln.com

# --- Logging (optional) ----------------------------------------------------
# debug | info | warn | error. Defaults to info.
# LOG_LEVEL=info
